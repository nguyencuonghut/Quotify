# Application
APP_NAME=Quotify
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Public entrypoint
DOMAIN_NAME=quotify.honghafeed.com.vn
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
CORS_ORIGINS=https://quotify.honghafeed.com.vn
TRUSTED_PROXY_CIDRS=172.30.0.0/24
PROD_DOCKER_SUBNET=172.30.0.0/24

# Config nginx cho reverse-proxy — mặc định prod.conf (bắt buộc có SSL cert).
# Nếu CHƯA sẵn sàng bật SSL, đổi thành NGINX_CONF_FILE=prod-http-only.conf và
# xem mục "Chạy production không cần SSL" trong
# docs/runbooks/deploy-vps-production.md (cần đổi thêm CORS_ORIGINS thành
# http://, và AUTH_REFRESH_COOKIE_SECURE=false bên dưới).
# Bảo trì tạm thời: NGINX_CONF_FILE=maintenance.conf (trả 503, xem mục 13.2 của runbook).
NGINX_CONF_FILE=prod.conf

# TLS (Let's Encrypt qua certbot, xem docs/runbooks/deploy-vps-production.md)
CERTBOT_EMAIL=change-me-admin-email@honghafeed.com.vn

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Quotify
VITE_APP_TIMEZONE=Asia/Ho_Chi_Minh
VITE_AUTH_LOGGED_IN_COOKIE_NAME=quotify_logged_in

# Database
# Nếu POSTGRES_PASSWORD chứa ký tự đặc biệt (@ # : / % hoặc khoảng trắng),
# PHẢI percent-encode riêng đoạn mật khẩu khi ghép vào DATABASE_URL bên dưới
# (ký tự "@" trong URI là dấu phân cách, dán thẳng sẽ khiến parse sai host) —
# xem "2.3 Mật khẩu Postgres có ký tự đặc biệt" trong
# docs/runbooks/deploy-vps-production.md để có lệnh mã hóa cụ thể.
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres-password@postgres:5432/app
DATABASE_URL_FILE=

# Auth
JWT_SECRET_KEY=change-me-strong-access-secret
JWT_REFRESH_SECRET_KEY=change-me-strong-refresh-secret
JWT_SECRET_KEY_FILE=
JWT_REFRESH_SECRET_KEY_FILE=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_TOKEN_TRANSPORT=hybrid
AUTH_REFRESH_COOKIE_NAME=quotify_refresh_token
# true khi chạy HTTPS (mặc định); đổi thành false nếu tạm chạy HTTP-only
# (NGINX_CONF_FILE=prod-http-only.conf ở trên) — browser sẽ âm thầm bỏ qua
# cookie Secure khi gửi qua HTTP, làm hỏng hoàn toàn luồng đăng nhập.
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_SEED_ADMIN_EMAIL=admin@quotify.local
AUTH_SEED_ADMIN_PASSWORD=change-me-admin-password
AUTH_SEED_UPDATE_ADMIN_PASSWORD=false

# MinIO
MINIO_ENDPOINT=minio:9000
# Đổi cả 2 giá trị khỏi mặc định của image — production không được giữ
# username "minioadmin" mặc định.
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-password
MINIO_ACCESS_KEY_FILE=
MINIO_SECRET_KEY_FILE=
MINIO_BUCKET=app-prod
MINIO_SECURE=false

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_FROM_EMAIL=noreply@quotify.local
ADMIN_EMAIL_FOR_BACKUPS=admin@quotify.local

# Telegram (tính năng TẮT mặc định, bật ở bước triển khai cuối của Giai đoạn 1A)
# TELEGRAM_WEBHOOK_SECRET sinh bằng `openssl rand -hex 32` (KHÔNG dùng -base64: chỉ cho phép A-Z a-z 0-9 _ -).
# Đặt bot token và secret trong .env trên VPS (hoặc *_FILE), KHÔNG commit giá trị thật.
TELEGRAM_ENABLED=false
# Giai đoạn pilot của thông báo biến động giá: email người nhận, cách nhau bằng dấu phẩy.
# Để trống = mọi người đã liên kết Telegram đều nhận (khi tính năng được bật).
PRICE_ALERT_RECIPIENT_EMAILS=
# Địa chỉ web công khai dùng cho liên kết trong tin Telegram.
APP_PUBLIC_URL=https://quotify.honghafeed.com.vn
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_BOT_USERNAME=HonghaQuotifyBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_FILE=
TELEGRAM_WEBHOOK_URL=https://quotify.honghafeed.com.vn/api/v1/telegram/webhook
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_HTTP_TIMEOUT_SECONDS=10
# Chatbot (kế hoạch 5.1): TẮT mặc định, cần thêm TELEGRAM_ENABLED=true. Cần worker riêng
# `arq app.bot_worker.BotWorkerSettings` (production: `--profile chatbot`, xem runbook mục 16).
# Công tắc tắt khẩn cấp: CHATBOT_ENABLED=false rồi tạo lại CẢ backend và bot-worker. Backend cũng đọc
# CHATBOT_* (webhook chuyển tin vào hộp thư, /metrics báo `quotify_bot_enabled`), BOT_QUEUE_NAME và
# BOT_MAX_PENDING_PER_CHAT: đổi bất kỳ biến BOT_* nào cũng phải tạo lại cả hai service.
CHATBOT_ENABLED=false
# Email người dùng thử, cách nhau bằng dấu phẩy, không phân biệt hoa thường. Rỗng = mọi người đã liên
# kết; có giá trị = CHỈ những người này. Có giá trị mà không có email nào (vd chỉ dấu phẩy) = đóng.
CHATBOT_PILOT_USER_EMAILS=
# Hàng đợi arq riêng (khác `arq:queue` nên worker cũ không lấy job của bot) và số việc chạy đồng thời.
BOT_QUEUE_NAME=quotify:bot
BOT_WORKER_MAX_JOBS=8
# Chu kỳ ghi khóa sức khỏe của arq; healthcheck compose dùng `arq --check`. Khóa sống thêm 1 giây.
BOT_HEALTH_CHECK_INTERVAL_SECONDS=30
# Ngân sách thời gian. Giữ: BOT_JOB_TIMEOUT > DRAIN + ROW_TIMEOUT + SEND_BUDGET (90 + 120 + 60) và
# BOT_LEASE > ROW_TIMEOUT + SEND_BUDGET (180); nếu không lease hết hạn khi đang xử lý và job chạy chồng.
BOT_JOB_TIMEOUT_SECONDS=300
BOT_DRAIN_BUDGET_SECONDS=90
BOT_ROW_TIMEOUT_SECONDS=120
BOT_SEND_BUDGET_SECONDS=60
BOT_LEASE_SECONDS=240
# Thử lại: tối đa BOT_MAX_ATTEMPTS lần, giãn cách BOT_RETRY_BACKOFF_SECONDS nhân số lần đã thử.
BOT_MAX_ATTEMPTS=3
BOT_RETRY_BACKOFF_SECONDS=5
# Chống dồn tin: số tin đang chờ tối đa của một chat (vượt thì bot trả lời lịch sự, không ghi hộp thư).
BOT_MAX_PENDING_PER_CHAT=5
# Hạn mức mỗi người mỗi ngày (giờ Việt Nam, đặt lại lúc 00:00), áp cho MỌI người dùng kể cả quản trị viên;
# 0 là không giới hạn loại đó. Lượt gửi ảnh hoặc PDF là tập con của lượt hỏi. Cả backend (lệnh /limit) và
# bot-worker (chặn thật) đọc các biến này: đổi thì tạo lại cả hai. Còn BOT_QUOTA_WARN_REMAINING_PERCENT
# phần trăm hạn mức thì thêm dòng "Còn N/M lượt hôm nay." cuối câu trả lời (0 là tắt nhắc).
BOT_DAILY_TURN_LIMIT=20
BOT_DAILY_FILE_LIMIT=5
BOT_QUOTA_WARN_REMAINING_PERCENT=20
# Tin chờ lâu hơn TTL (giữ >= MAX_PENDING_PER_CHAT x (ROW_TIMEOUT + SEND_BUDGET) = 900) bị bỏ và báo cho
# người gửi; cron quét đánh chuông lại tin chờ quá BOT_SWEEP_STALE_SECONDS; dòng đã kết thúc xóa sau
# BOT_TERMINAL_RETENTION_DAYS ngày (nội dung tin đã bị xóa từ lúc kết thúc; tối thiểu 1 vì hạn mức mỗi
# ngày đếm từ các dòng này).
BOT_MESSAGE_TTL_SECONDS=1200
BOT_SWEEP_STALE_SECONDS=30
BOT_TERMINAL_RETENTION_DAYS=30
# Gửi trả lời: chỉ báo "đang gõ" của Telegram kéo dài khoảng 5 giây nên làm mới mỗi 4 giây; câu trả lời
# dài chia tối đa BOT_REPLY_MAX_PARTS tin.
BOT_TYPING_INTERVAL_SECONDS=4
BOT_REPLY_MAX_PARTS=4
# Pool kết nối DB của bot-worker (tường minh vì mặc định chung 5 + 10 là quá nhiều): engine chính tối đa
# 4 + 4 = BOT_WORKER_MAX_JOBS, engine chỉ đọc cho công cụ của chatbot tối đa 2 + 1.
BOT_DB_POOL_SIZE=4
BOT_DB_MAX_OVERFLOW=4
BOT_READONLY_POOL_SIZE=2
BOT_READONLY_MAX_OVERFLOW=1
BOT_READONLY_POOL_TIMEOUT_SECONDS=3
# Truy vấn công cụ chạy quá statement timeout bị hủy; phiên rảnh trong giao dịch quá mức kia bị cắt
# (nên lớn hơn statement timeout).
BOT_READONLY_STATEMENT_TIMEOUT_MS=5000
BOT_READONLY_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security
LOG_LEVEL=INFO
LOG_FORMAT=json
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LOGIN=5
RATE_LIMIT_FILES_UPLOAD=10
RATE_LIMIT_USERS_AVATAR_UPLOAD=10
RATE_LIMIT_USERS_IMPORT=5
RATE_LIMIT_USERS_EXPORT=10
RATE_LIMIT_EXCHANGE_RATES=20
RATE_LIMIT_TELEGRAM_LINK_TOKEN=5
VIETCOMBANK_EXCHANGE_RATE_URL=https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx
VIETCOMBANK_EXCHANGE_RATE_TIMEOUT_SECONDS=5
VIETCOMBANK_EXCHANGE_RATE_RETRY_COUNT=1
# API JSON không chính thức, chỉ dùng để lấy tỷ giá NGÀY TRONG QUÁ KHỨ (khác
# feed ở trên, chỉ trả tỷ giá hiện tại) — có thể đổi/ngừng hoạt động bất kỳ
# lúc nào vì không có tài liệu chính thức từ Vietcombank.
VIETCOMBANK_HISTORICAL_EXCHANGE_RATE_URL=https://www.vietcombank.com.vn/api/exchangerates
VIETCOMBANK_HISTORICAL_EXCHANGE_RATE_TIMEOUT_SECONDS=5
VIETCOMBANK_HISTORICAL_EXCHANGE_RATE_RETRY_COUNT=1

# Observability
OBSERVABILITY_ENABLED=true
METRICS_ENABLED=true
METRICS_PATH=/metrics
READINESS_PATH=/ready
OTEL_ENABLED=true
OTEL_SERVICE_NAME=quotify-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_HEADERS=

# SLO
SLO_API_AVAILABILITY_TARGET=99.9
SLO_API_P95_MS=400
SLO_AUTH_LOGIN_P95_MS=500
SLO_IMPORT_JOB_SUCCESS_RATE=99.0

# Backup
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=14
